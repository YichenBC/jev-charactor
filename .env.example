OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
PORT=4317
# Optional per-project DNS server IP; empty uses the system resolver. TLS verification remains enabled.
JEV_DNS_SERVER=
# Required for --provider llm or llm-character evaluations; choose a model supporting structured outputs.
EVAL_LLM_MODEL=
# Evaluation only. Default openrouter; self-hosted uses its own URL and optional key.
EVAL_LLM_BACKEND=openrouter
EVAL_LLM_BASE_URL=
EVAL_LLM_API_KEY=
# Optional: 1..120000 ms (OpenRouter custom DNS is limited to 12000).
EVAL_LLM_TIMEOUT_MS=
# Optional: 1..8192 tokens. Unset defaults to full-character 600, selector 200.
EVAL_LLM_MAX_OUTPUT_TOKENS=
# Existing self-hosted moonshotai/Kimi-K3 only: enabled/disabled; unset uses deployment default.
EVAL_LLM_THINKING=
